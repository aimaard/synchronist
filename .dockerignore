.git
.github
.env*
docker-compose*.yml

/.bundle
/vendor/bundle
/node_modules
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/test

# Local databases, logs and temporary files must not end up in the image (or the storage volume)
/storage/*
!/storage/.keep
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
/tmp/pids/*
!/tmp/pids/.keep
